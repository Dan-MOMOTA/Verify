#!/bin/csh
set file_path=`/usr/sbin/lsof +p $$ |& \/bin/grep -oE /.\*unit.env`
if ("$file_path" == "") then
    echo "Error: unit.env not found"
    exit 1
endif

set config_dir = `dirname "$file_path"`
setenv UNIT_ICDIR `dirname "$config_dir"`
echo "UNIT_ICDIR: set to $UNIT_ICDIR"

set tmp_dir = `dirname "$UNIT_ICDIR"`
setenv PRJ_ICDIR `dirname $tmp_dir`
echo "PRJ_ICDIR: set to $PRJ_ICDIR"

source $PRJ_ICDIR/env/prj.env
#setenv UNIT_NAME unipro_mphy 

if (-f "$UNIT_ICDIR/config/eda_setup.env") then
    echo "set unit eda tools"
    source "$UNIT_ICDIR/config/eda_setup.env"
else
    echo "Error: $UNIT_ICDIR/config/eda_setup.env not found"
endif

if (-f $UNIT_ICDIR/config/alias.env) then
    echo "set unit alias"
    source $UNIT_ICDIR/config/alias.env
endif
