module purge

#MODULE
setenv MODULEPATH ""
source /data/tools/modules/5.5.0/init/profile.csh
module use /data/tools/modules/modulefiles
setenv MODULEPATH /data/tools/modules/modulefiles

#VCS Verdi
module load vcs/2023.12-SP2-8
module load verdi/2023.12-SP2-8
module load license

# UVM
setenv UVM_HOME "${VCS_HOME}/etc/uvm-1.2"

#PYTHON
setenv PYTHONPATH "/data/tools/python_package/:$FILELIST_PATH"

#YRUN
module load yrun/yrun5.5
setenv YRUN_FLOW_ROOT  YRUN_PATH
setenv YRUN_INFO_ROOT  $UNIT_ICDIR/verif/sim_ctrl
setenv YRUN_TRUNK_ROOT $UNIT_ICDIR
setenv YRUN_UNIT_ICDIR $UNIT_ICDIR
setenv YRUN_EXPORT_CMD "safety_floder.sh"
setenv PRJ_QUEEN yrun
setenv YRUN_LSF_OPT "-q $PRJ_QUEEN -P $PRJ_NAME"
setenv YRUN_MAX_LSF_JOB 20
setenv YRUN_ERROR_CHAR_NUM 200
setenv YRUN_CHECK_DEBUG 1
setenv YRUN_DPI_GEN_ROOT /proj/unipro_v2_0/users/
setenv YRUN_FLOW_ROOT "/data/public/y-run/yrun5.5"
setenv CSIM_PATH "/data/tools/inhouse/csim/v1p4"
#setenv FSDB_LOC "/tmpdir/hg2325/users/xxx/"
#setenv VDB_LOC "/tmpdir/hg2325/users/xxx/"

module list
