#!/bin/csh
set called=($_)
if ( "$called" != "" ) then 
    if ("$called[2]" =~ "*prj.env") then 
        set  UNSET_GROUP = `env | grep "_ICDIR=" | awk -F "=" '{print $1}'`
        foreach UNSET_VAR ($UNSET_GROUP)
            unsetenv $UNSET_VAR
        end
    endif
endif
   

if !($?PRJ_ICDIR) then
    #set file_path=`readlink -f $called[2]`
    #set file_path=`/usr/bin/ls -l /proc/$$/fd | sed -e 's/^[^/]*//' | grep -oE /.\*prj.env`
    set file_path=`/usr/sbin/lsof +p $$ |& \/bin/grep -oE /.\*prj.env`
    set env_dir = `dirname $file_path`
    setenv PRJ_ICDIR `dirname $env_dir`
    #setenv PRJ_ICDIR `find_open_file $$ prj.env`
    echo "PRJ_ICDIR: set to $PRJ_ICDIR"
endif
#setenv PRJ_NAME HG2288 
#TODO: ask someone about the PRJ_NAME for unipro_v2_0
setenv PRJ_NAME UNIPRO_V2_0
setenv PRJ_TYPE SOC

#special handle for nox
if ($?HOSTNAME) then
    if ( $HOSTNAME == 'nox.ic.hosinglobal.com' ) then
        setenv NOX_FLIST_RULE 1
    endif
endif

if (-f $PRJ_ICDIR/env/eda_setup.env) then
    echo "set global eda tools"
    source $PRJ_ICDIR/env/eda_setup.env
endif

if (-f $PRJ_ICDIR/env/alias.env) then
    echo "set global alias"
    source $PRJ_ICDIR/env/alias.env
endif


source $PRJ_ICDIR/top/verif/nds_cpu_unipro_mphy/env_setting/set_andes


# #Avery's VIP
# module load avery_ufs/2.0e.240307
# #module load avery_ufs/2.0e-old
# module load avery_pli/2023.11.28
# set path=($path $AVERY_MIPI/scripts)
